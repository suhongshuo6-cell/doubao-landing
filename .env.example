# 火山方舟（豆包）Chat Completions —— 可选
# 复制为 .env.local 后仅在本地 `npm run dev` 使用。
#
# ⚠ 警告：VITE_ 前缀变量会打进前端包。
# 纯静态托管（如 GitHub Pages）会暴露 Key，切勿把生产 Key 写进可公开仓库。
# 本接线默认用于本地演示；无 Key 时自动走假智能，功能完整。
#
# 浏览器直连 https://ark.cn-beijing.volces.com 常因 CORS 失败：
# `npm run dev` 已配置 /ark-api 代理。生产请自备后端或同源反代，并设置 VITE_ARK_BASE。

VITE_ARK_API_KEY=
# 模型名或控制台「推理接入点」ID（ep-...）
VITE_ARK_MODEL=doubao-pro-32k
# 可选：生产同源反代，例如 https://your.domain.com/ark-api
# VITE_ARK_BASE=

# ---------------------------------------------------------------------------
# Dify（豆包接入口）Chat Messages —— 可选
# 复制为 .env.local 后仅在本地 `npm run dev` 使用。
#
# ⚠ 警告：VITE_ 前缀变量会打进前端包。
# GitHub Pages 等纯静态托管会暴露 Key，切勿把生产 Key 提交到公开仓库。
# 可改用运行时 window.__DIFY_API_KEY__ 注入，或自备后端反代。
# 无 Key 时 askbar 自动走假智能，并轻提示「未配置 API Key」。
#
# 控制台 Backend API base：https://api.dify.ai/v1（不是 udify.app）
# 本地 dev 已配置 /dify-api → https://api.dify.ai。
# 生产请设 VITE_DIFY_BASE_URL=https://api.dify.ai/v1（直连；若 CORS 失败会回退假智能）。

VITE_DIFY_API_KEY=
# 生产 API 基址（含 /v1，无尾斜杠）
VITE_DIFY_BASE_URL=https://api.dify.ai/v1
